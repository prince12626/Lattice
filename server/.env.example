NODE_ENV=development
PORT=4000
HOST=127.0.0.1

MONGODB_URI=mongodb://127.0.0.1:27017/llm_gateway

# Generate a unique value with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-unique-secret-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:4000
FRONTEND_ORIGIN=http://localhost:3000

# Generate a unique 32-byte hex value with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

LOG_LEVEL=info
ADMIN_API_KEY=replace-with-a-unique-admin-key-at-least-32-characters
